# Copy to .env.local and fill in. Never put real values in this file: it is committed.

# Postgres (Neon). Pooled connection string.
DATABASE_URL=

# Login. Generate the hash with `pnpm passcode:hash` and paste the output here.
APP_PASSCODE_HASH=

# Signs the session cookie. Any long random string (32+ characters).
SESSION_SECRET=

# The origin baked into sticker QR codes, e.g. https://cards.example.com
# Fixed before the first stickers are printed: changing it breaks camera-app links on old stickers.
PUBLIC_BASE_URL=

# Display time zone for dates on stickers and reports
APP_TZ=America/Los_Angeles

# Card photo lookup on Buy/Trade (either works alone; CardSight is tried first)
CARDSIGHT_API_KEY=
ANTHROPIC_API_KEY=
# only for an organization-wide Anthropic key (not scoped to one workspace): the workspace id, wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Vercel sends this to the nightly price-catalog cron
CRON_SECRET=
